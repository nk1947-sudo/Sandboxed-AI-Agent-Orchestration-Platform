# .env.example — copy to .env and fill in. .env is gitignored; never commit secrets.
# The control plane reads all configuration from the environment (12-factor).

# ── Firecracker / orchestrator ───────────────────────────────────────────────
USE_JAILER=true
FC_BIN=/usr/local/bin/firecracker
JAILER_BIN=/usr/local/bin/jailer
KERNEL_IMAGE=/var/lib/sandbox/vmlinux
ROOTFS_IMAGE=/var/lib/sandbox/rootfs.ext4
CHROOT_BASE=/srv/jailer
JAILER_UID=10001
JAILER_GID=10001
STATE_DIR=/srv/sandbox-state
CGROUP_ROOT=/sys/fs/cgroup
CGROUP_BASE=sandboxes
MAX_CONCURRENT=5
MEMORY_BUDGET_MIB=2048

# ── Egress networking (opt-in; default off = secure none-networking) ──────────
# When false, every VM boots with loopback only. When true, a VM launched with
# {"egress":true} gets a per-VM TAP on the sandbox bridge; the host nftables rules
# (deploy/firewall/sandbox.nft) + Squid (deploy/squid/squid.conf) enforce a
# default-deny allowlist and block IMDS. Set up the host pieces first — see the
# "Opt-in egress" runbook in DEPLOY_LINUX.md.
EGRESS_ENABLED=false
EGRESS_GATEWAY_IP=10.200.0.1
EGRESS_NETMASK=255.255.255.0
EGRESS_TAP_SCRIPT=scripts/vm-tap.sh
# Optional compiled seccomp-BPF filter (scripts/build-seccomp.sh). Applied on the
# non-jailer path; under the jailer Firecracker's built-in filter is used. Empty
# = built-in filter.
SECCOMP_FILTER=

# ── HTTP / gateway ───────────────────────────────────────────────────────────
HTTP_ADDR=:7777
# Service/CLI bearer token (curl, scripts/test-terminal.py). Browser logins use
# accounts + a session cookie instead. openssl rand -hex 32
API_TOKEN=dev-secret-123
# WebSocket CORS allowlist (comma-separated). Empty = same-host only.
# IMPORTANT: with the Dockerized UI (nginx on :3000 reverse-proxying to this
# control plane), the browser's Origin is http://localhost:3000 and the same-host
# fallback does NOT match through the proxy — set this explicitly or the terminal
# WebSocket handshake is rejected with 403:
#   ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=
HITL_TTL_SEC=3600
VSOCK_RETRY_MAX=10

# ── Redis (ephemeral: HITL queue, rate limits, heartbeats) ───────────────────
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── PostgreSQL (durable: users, sessions, history, snapshots, transcripts) ───
# Leave PG_HOST empty to run WITHOUT accounts/history/resume.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=Admin@123
PG_DB=sandbox
PG_SSLMODE=disable

# ── Auth / sessions ──────────────────────────────────────────────────────────
# First admin, created on first startup when the users table is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
SESSION_TTL_HOURS=24
# Set true in production (HTTPS) so the session cookie carries the Secure flag.
COOKIE_SECURE=false
TRANSCRIPT_RETENTION_DAYS=30

# ── Lifecycle ────────────────────────────────────────────────────────────────
SHUTDOWN_TERMINATES_ALL=true
HEARTBEAT_TTL_SEC=15
HEALTH_INTERVAL_SEC=5
